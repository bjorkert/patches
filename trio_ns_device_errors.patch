+// MARK: - Nightscout device error reporting (workspace patch)
+//
+// Self-contained, fire-and-forget uploader for CGM (Dexcom) and pump (Omnipod)
+// errors. Posts a Nightscout "Note" treatment. Fully crash-safe: if credentials
+// are missing or Nightscout is unreachable the call is a silent no-op. No queue,
+// no retry. In-memory de-duplication suppresses identical errors for 30 minutes.
+final class NightscoutErrorReporter {
+    static let shared = NightscoutErrorReporter()
+
+    private let queue = DispatchQueue(label: "NightscoutErrorReporter.queue")
+    private var lastSent: [String: Date] = [:]
+    private let dedupeWindow: TimeInterval = 30 * 60
+
+    private init() {}
+
+    /// Report a device error to Nightscout. Safe to call from any thread.
+    /// - Parameters:
+    ///   - source: e.g. "Dexcom" or "Omnipod".
+    ///   - code: short error category/identifier used for de-duplication.
+    ///   - message: human readable description.
+    func report(source: String, code: String, message: String) {
+        let trimmed = message.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { return }
+
+        queue.async { [weak self] in
+            guard let self = self else { return }
+
+            let key = "\(source)|\(code)|\(trimmed)"
+            let now = Date()
+            if let last = self.lastSent[key], now.timeIntervalSince(last) < self.dedupeWindow {
+                return
+            }
+
+            guard let (url, secret) = self.credentials() else { return }
+
+            // Mark as sent before dispatching the upload so repeated errors are
+            // throttled even while a request is in flight.
+            self.lastSent[key] = now
+
+            Task.detached(priority: .utility) {
+                await Self.upload(url: url, secret: secret, source: source, notes: trimmed, date: now)
+            }
+        }
+    }
+
+    private func credentials() -> (URL, String)? {
+        let keychain = BaseKeychain()
+        guard
+            let urlString = keychain.getValue(String.self, forKey: NightscoutConfig.Config.urlKey),
+            let url = URL(string: urlString),
+            let secret = keychain.getValue(String.self, forKey: NightscoutConfig.Config.secretKey),
+            !secret.isEmpty
+        else {
+            return nil
+        }
+        return (url, secret)
+    }
+
+    private struct NoteTreatment: Encodable {
+        let eventType = "Note"
+        let enteredBy = "Trio"
+        let notes: String
+        let created_at: String
+    }
+
+    private static func upload(url: URL, secret: String, source: String, notes: String, date: Date) async {
+        do {
+            let endpoint = url.appendingPathComponent("api/v1/treatments.json")
+            var request = URLRequest(url: endpoint)
+            request.httpMethod = "POST"
+            request.timeoutInterval = 30
+            request.addValue("application/json", forHTTPHeaderField: "Content-Type")
+            request.addValue(sha1Hex(secret), forHTTPHeaderField: "api-secret")
+
+            let formatter = ISO8601DateFormatter()
+            let treatment = NoteTreatment(notes: "[\(source)] \(notes)", created_at: formatter.string(from: date))
+            request.httpBody = try JSONEncoder().encode([treatment])
+
+            _ = try await URLSession.shared.data(for: request)
+        } catch {
+            // Intentionally ignored: never let error reporting affect the app.
+        }
+    }
+
+    private static func sha1Hex(_ string: String) -> String {
+        let data = Data(string.utf8)
+        var digest = [UInt8](repeating: 0, count: Int(CC_SHA1_DIGEST_LENGTH))
+        data.withUnsafeBytes {
+            _ = CC_SHA1($0.baseAddress, CC_LONG(data.count), &digest)
+        }
+        return digest.map { String(format: "%02hhx", $0) }.joined()
+    }
+}
